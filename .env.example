# 로컬 개발 전용 예시입니다. 운영 환경에서는 모든 값을 별도로 교체하세요.
APP_PORT=8080
FRONTEND_DEV_PORT=5173
ADMINER_PORT=8081
TUNNEL_ORIGIN_PORT=8080
POSTGRES_DB=guess_pokemon_dev
POSTGRES_USER=guess_pokemon_dev
POSTGRES_PASSWORD=local-change-me
SESSION_COOKIE_SECURE=false
POKEMON_ARTWORK_ENABLED=true

# named tunnel에서만 사용합니다. 실제 token 파일은 Git에 추가하지 않습니다.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token
